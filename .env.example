# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Pexels API Key for Lookbook curation (Optional - https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash Access Key (Optional - https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Remove.bg API Key for background removal on uploaded garments (Optional - https://www.remove.bg/api)
REMOVEBG_API_KEY=your_removebg_api_key_here

# Optional Ports
PORT=3000
LANGGRAPH_PORT=5000
